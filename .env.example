# ── App ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=compliance_pass
DATABASE_URL=postgresql+asyncpg://compliance_user:compliance_pass@postgres:5432/compliance_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant ────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── MinIO / S3 ────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=compliance-docs
S3_REGION=us-east-1

# ── LLM providers ─────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://ollama:11434

# ── LiteLLM ───────────────────────────────────────────
LITELLM_DEFAULT_MODEL=gpt-4o-mini
LITELLM_REASONING_MODEL=gpt-4o
LITELLM_LOCAL_MODEL=ollama/llama3.1

# ── Notifications ─────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG....
