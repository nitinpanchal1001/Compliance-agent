# ── App ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=compliance_pass
DATABASE_URL=postgresql+asyncpg://compliance_user:compliance_pass@postgres:5432/compliance_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant (vector store) ─────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── MinIO / S3 (document storage) ─────────────────────
# S3_ENDPOINT_URL: leave blank for real AWS S3; set for MinIO/S3-compatible.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=compliance-docs
S3_REGION=us-east-1

# ── LLM providers ─────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://ollama:11434

# ── LiteLLM (model routing) ───────────────────────────
# Reasoning agent uses LITELLM_REASONING_MODEL. Swap to a Claude model
# (e.g. claude-opus-4-8) by changing this + setting ANTHROPIC_API_KEY.
LITELLM_DEFAULT_MODEL=gpt-4o-mini
LITELLM_REASONING_MODEL=gpt-4o
LITELLM_LOCAL_MODEL=ollama/llama3.1

# ── Embeddings / transcription ────────────────────────
# EMBEDDING_DIM must match the embedding model's output (and the Qdrant
# collections' vector size). text-embedding-3-small = 1536.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_WHISPER_MODEL=whisper-1

# ── Ingestion tuning ──────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
QDRANT_COLLECTION=document_chunks
MAX_UPLOAD_MB=50

# ── Policy corpus / RAG ───────────────────────────────
# POLICY_CORPUS_PATH is the in-container path where policy_corpus is mounted.
POLICY_COLLECTION=policy_chunks
POLICY_CORPUS_PATH=/policy_corpus
POLICY_RETRIEVAL_TOP_K=5

# ── Reasoning / analysis ──────────────────────────────
# REASONING_TOP_K: policy clauses retrieved per document chunk.
REASONING_TOP_K=5
MAX_CHUNKS_PER_ANALYSIS=50
REASONING_TEMPERATURE=0.0

# ── Notifications ─────────────────────────────────────
# NOTIFY_FROM_EMAIL must be a verified sender for your SMTP provider
# (e.g. SendGrid requires sender/domain verification).
NOTIFICATIONS_ENABLED=true
NOTIFY_FROM_EMAIL=compliance-agent@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG....
