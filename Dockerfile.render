FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install uv

WORKDIR /app

# ── deps layer (cached unless pyproject.toml changes) ──
FROM base AS deps
COPY backend/pyproject.toml backend/uv.lock* ./
RUN uv sync --no-dev

# ── final image ────────────────────────────────────────
FROM base AS final
# Copy the virtualenv built in deps (not system Python — uv uses .venv by default)
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY backend/ .
COPY policy_corpus/ /policy_corpus/

EXPOSE 8000

# Single worker — Render free tier is 512 MB RAM
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
