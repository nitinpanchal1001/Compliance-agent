FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1

RUN pip install uv

WORKDIR /app

# ── deps layer (cached unless pyproject.toml changes) ──
FROM base AS deps
COPY backend/pyproject.toml backend/uv.lock* ./
RUN uv sync --no-dev

# ── final image ────────────────────────────────────────
FROM base AS final
COPY --from=deps /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=deps /usr/local/bin /usr/local/bin
COPY backend/ .
# Embed the policy corpus so it's available without a volume mount on Render.
COPY policy_corpus/ /policy_corpus/

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
