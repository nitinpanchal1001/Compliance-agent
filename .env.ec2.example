# Production environment — EC2 (API + Worker + Redis + Caddy) + Vercel (Frontend)
# Copy to .env on the instance and fill in real values.
# Generate secrets: openssl rand -hex 32

# ── App ───────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
DEBUG=false

# ── Caddy (TLS termination) ───────────────────────────
# DOMAIN must have an A record pointing at the instance's Elastic IP.
DOMAIN=api.yourdomain.com
TLS_EMAIL=you@example.com

# ── PostgreSQL (Neon) ─────────────────────────────────
# Format: take the Neon connection string, change postgresql:// → postgresql+asyncpg://
# and append ?sslmode=require
DATABASE_URL=

# ── Redis (local container — replaces Upstash) ────────
# Plain redis:// (no TLS): Redis is only reachable inside the Docker network.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant Cloud ──────────────────────────────────────
QDRANT_URL=https://YOUR-CLUSTER-ID.YOUR-REGION.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Cloudflare R2 (document storage) ─────────────────
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=compliance-docs
S3_REGION=auto

# ── LLM / embeddings ─────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_DEFAULT_MODEL=gpt-4o-mini
LITELLM_REASONING_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_WHISPER_MODEL=whisper-1

# ── CORS ─────────────────────────────────────────────
# Your Vercel frontend URL(s), comma-separated.
CORS_ORIGINS=https://compliance-agent-rose.vercel.app

# ── Ingestion / RAG / reasoning ───────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
QDRANT_COLLECTION=document_chunks
MAX_UPLOAD_MB=50
POLICY_COLLECTION=policy_chunks
POLICY_CORPUS_PATH=/policy_corpus
POLICY_RETRIEVAL_TOP_K=5
REASONING_TOP_K=5
MAX_CHUNKS_PER_ANALYSIS=50
REASONING_TEMPERATURE=0.0

# ── Security ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Notifications (optional) ──────────────────────────
NOTIFICATIONS_ENABLED=true
NOTIFY_FROM_EMAIL=compliance-agent@example.com
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=