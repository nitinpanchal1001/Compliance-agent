# Production environment — Render (API + Worker) + Vercel (Frontend)
# Copy and fill in real values before deploying.
# Generate secrets: openssl rand -hex 32

# ── App ───────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
DEBUG=false

# ── PostgreSQL (Neon) ─────────────────────────────────
# Format: take the Neon connection string, change postgresql:// → postgresql+asyncpg://
# and append ?sslmode=require
DATABASE_URL=

# ── Redis (Upstash) ───────────────────────────────────
# Use rediss:// (double-s) for TLS. All three point to the same instance.
# Token: reveal via the dots next to "Token" in the Upstash console.
REDIS_URL=rediss://default:YOUR_TOKEN@adapting-collie-97529.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_TOKEN@adapting-collie-97529.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:YOUR_TOKEN@adapting-collie-97529.upstash.io:6379

# ── Qdrant Cloud ──────────────────────────────────────
# Use QDRANT_URL (full https URL) for Qdrant Cloud — host/port are for local Docker only.
QDRANT_URL=https://YOUR-CLUSTER-ID.YOUR-REGION.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Cloudflare R2 (document storage) ─────────────────
# Account ID: top-right of the R2 page in Cloudflare dashboard.
# API token: R2 → Manage R2 API Tokens → create token with Object Read & Write.
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=compliance-docs
S3_REGION=auto

# ── LLM / embeddings ─────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LITELLM_DEFAULT_MODEL=gpt-4o-mini
LITELLM_REASONING_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_WHISPER_MODEL=whisper-1

# ── CORS ─────────────────────────────────────────────
# Set to your Vercel frontend URL (API service only).
CORS_ORIGINS=https://your-app.vercel.app

# ── Ingestion / RAG / reasoning ───────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
QDRANT_COLLECTION=document_chunks
MAX_UPLOAD_MB=50
POLICY_COLLECTION=policy_chunks
POLICY_CORPUS_PATH=/policy_corpus
POLICY_RETRIEVAL_TOP_K=5
REASONING_TOP_K=5
MAX_CHUNKS_PER_ANALYSIS=50
REASONING_TEMPERATURE=0.0

# ── Security ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Notifications (optional) ──────────────────────────
NOTIFICATIONS_ENABLED=true
NOTIFY_FROM_EMAIL=compliance-agent@example.com
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
