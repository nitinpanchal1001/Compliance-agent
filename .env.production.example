# Production environment for the single-VM deploy.
# Copy to .env on the server and fill in real values:  cp .env.production.example .env
# Generate strong secrets, e.g.:  openssl rand -hex 32

# ── App ──────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
DEBUG=false

# ── Public hostname (for Caddy auto-HTTPS) ───────────
# A real hostname that resolves to this VM's public IP.
# Free option: a DuckDNS subdomain, e.g. mycompliance.duckdns.org
DOMAIN=your-app.example.com
TLS_EMAIL=you@example.com

# Browser origins allowed for CORS. Same-origin behind Caddy means this is
# mostly belt-and-suspenders; set it to your public URL.
CORS_ORIGINS=https://your-app.example.com

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
DATABASE_URL=postgresql+asyncpg://compliance_user:CHANGE-ME-strong-db-password@postgres:5432/compliance_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant (vector store) ─────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── MinIO / S3 (document storage) ─────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=CHANGE-ME-minio-access
S3_SECRET_KEY=CHANGE-ME-minio-secret
S3_BUCKET_NAME=compliance-docs
S3_REGION=us-east-1

# ── LLM / embeddings (OpenAI — kept as-is) ────────────
OPENAI_API_KEY=sk-...
LITELLM_DEFAULT_MODEL=gpt-4o-mini
LITELLM_REASONING_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_WHISPER_MODEL=whisper-1

# ── Ingestion / RAG / reasoning ───────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
QDRANT_COLLECTION=document_chunks
MAX_UPLOAD_MB=50
POLICY_COLLECTION=policy_chunks
POLICY_CORPUS_PATH=/policy_corpus
POLICY_RETRIEVAL_TOP_K=5
REASONING_TOP_K=5
MAX_CHUNKS_PER_ANALYSIS=50
REASONING_TEMPERATURE=0.0

# ── Security ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Notifications (optional; leave blank to disable email) ──
NOTIFICATIONS_ENABLED=true
NOTIFY_FROM_EMAIL=compliance-agent@example.com
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
